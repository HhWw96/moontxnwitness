      "sourceSha256": "cef3e4532e073e62e6658ec4ea54015f48470142612e0ea95f09e675f35df423",
      "source": "\nDECLARE k text; previous uuid; was_present boolean; v uuid; old_data jsonb; new_data jsonb;\nBEGIN\n IF TG_OP<>'DELETE' THEN\n  IF NEW.id IS NULL OR NEW.email IS NULL OR NEW.hashed_password IS NULL OR NEW.is_active IS NULL OR NEW.is_superuser IS NULL OR NEW.is_verified IS NULL THEN RETURN NEW; END IF;\n  IF TG_OP='UPDATE' AND NEW.id IS DISTINCT FROM OLD.id THEN RAISE EXCEPTION 'ORM fixed UUID mutation unsupported'; END IF;\n  k:=NEW.id::text;\n ELSE k:=OLD.id::text; END IF;\n SELECT token,present INTO previous,was_present FROM \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_state\" WHERE key=k FOR UPDATE;\n IF NOT FOUND THEN RAISE EXCEPTION 'ORM key outside controlled fixed domain'; END IF;\n IF TG_OP<>'INSERT' AND (NOT was_present OR previous IS DISTINCT FROM OLD.\"_mtw_orm_version\") THEN RAISE EXCEPTION 'ORM source chain mismatch'; END IF;\n v:=gen_random_uuid();\n old_data:=CASE WHEN TG_OP='INSERT' THEN NULL ELSE jsonb_build_object('id',OLD.\"id\"::text,'email',OLD.\"email\",'hashed_password',OLD.\"hashed_password\",'is_active',OLD.\"is_active\",'is_superuser',OLD.\"is_superuser\",'is_verified',OLD.\"is_verified\") END;\n new_data:=CASE WHEN TG_OP='DELETE' THEN NULL ELSE jsonb_build_object('id',NEW.\"id\"::text,'email',NEW.\"email\",'hashed_password',NEW.\"hashed_password\",'is_active',NEW.\"is_active\",'is_superuser',NEW.\"is_superuser\",'is_verified',NEW.\"is_verified\") END;\n INSERT INTO \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_candidates\"(token,key,predecessor,action,old_present,new_present,old_image,new_image)\n VALUES(v,k,previous,TG_OP,was_present,TG_OP<>'DELETE',old_data,new_data);\n IF TG_OP='DELETE' THEN RETURN OLD; ELSE NEW.\"_mtw_orm_version\":=v; RETURN NEW; END IF;\nEND\n",
