      "source": "\nDECLARE k text; v uuid; candidate record; n integer; actual_image jsonb;\nBEGIN\n IF TG_OP='DELETE' THEN k:=OLD.id::text; v:=\"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_deleted_version\"(k,OLD.\"_mtw_orm_version\"::text); actual_image:=NULL;\n ELSE k:=NEW.id::text; v:=NEW.\"_mtw_orm_version\"; actual_image:=jsonb_build_object('id',NEW.\"id\"::text,'email',NEW.\"email\",'hashed_password',NEW.\"hashed_password\",'is_active',NEW.\"is_active\",'is_superuser',NEW.\"is_superuser\",'is_verified',NEW.\"is_verified\"); END IF;\n SELECT * INTO candidate FROM \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_candidates\" WHERE token=v;\n IF NOT FOUND OR candidate.key IS DISTINCT FROM k OR candidate.action IS DISTINCT FROM TG_OP OR candidate.new_image IS DISTINCT FROM actual_image THEN RAISE EXCEPTION 'ORM actual effect candidate mismatch'; END IF;\n IF TG_OP='INSERT' AND candidate.old_present THEN RAISE EXCEPTION 'ORM insert source presence drift'; END IF;\n UPDATE \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_state\" SET token=v,present=(TG_OP<>'DELETE'),image=actual_image\n WHERE key=k AND token=candidate.predecessor AND present=candidate.old_present;\n GET DIAGNOSTICS n=ROW_COUNT;\n IF n<>1 THEN RAISE EXCEPTION 'ORM actual effect chain mismatch'; END IF;\n INSERT INTO \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_effects\" SELECT * FROM \"mtw_orm_v3_3a8f4a1188a4\".\"_mtw_orm_candidates\" WHERE token=v;\n IF TG_OP='DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\nEND\n",
