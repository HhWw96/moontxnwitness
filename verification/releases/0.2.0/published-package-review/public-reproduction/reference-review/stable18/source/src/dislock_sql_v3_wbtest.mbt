  assert_eq(proof.gaps.to_json(), Json::array([]))
  assert_eq(proof.verified_statements.length(), 2)
  assert_eq(proof.verified_facts.length(), 4)
  let ledger = v3_test_items(
    v3_test_items(trace, "sqlProfiles")[0],
    "effectLedger",
  )
  let removed = ledger.pop()
  assert_true(removed is Some(_))
  let missing = v3_dislock_sql_proof(object_fields(trace, "trace"))
  assert_eq(missing.verified_profiles.length(), 0)
  assert_true(!missing.gaps.is_empty())
}

