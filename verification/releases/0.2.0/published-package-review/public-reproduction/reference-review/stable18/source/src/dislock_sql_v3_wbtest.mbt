seq\":7,\"time\":407000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\"},{\"executedSql\":\"\\n        INSERT INTO \\\"mtw_provenance_dislock_v3_67dcf57e90_0\\\".\\\"key_value\\\" (key, value, expire_at)\\n        VALUES (%s, %s, %s)\\n        ON CONFLICT (key) DO UPDATE\\n        SET value = EXCLUDED.value,\\n            expire_at = EXCLUDED.expire_at\\n        WHERE \\\"mtw_provenance_dislock_v3_67dcf57e90_0\\\".\\\"key_value\\\".expire_at <= NOW()\\n        RETURNING key, expire_at,OLD.\\\"_mtw_v3_version\\\"::text,NEW.\\\"_mtw_v3_version\\\"::text,OLD.value,OLD.expire_at,NOW(),\\\"mtw_provenance_dislock_v3_67dcf57e90_0\\\".\\\"_mtw_v3_predecessor\\\"(NEW.\\\"_mtw_v3_version\\\"::text),CASE WHEN OLD.key IS NULL THEN 'INSERT' ELSE 'UPDATE' END;\\n        \",\"kind\":\"statement\",\"mappingId\":\"dislock.acquire-schedule/1\",\"parameters\":[\"cronjob-lock:schedule:fixture-schedule-and-server-clock\",\"owner-original\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 11:41:28.596548+08:00\"}],\"seq\":8,\"sql\":\"\\n        INSERT INTO \\\"mtw_provenance_dislock_v3_67dcf57e90_0\\\".\\\"key_value\\\" (key, value, expire_at)\\n        VALUES (%s, %s, %s)\\n        ON CONFLICT (key) DO UPDATE\\n        SET value = EXCLUDED.value,\\n            expire_at = EXCLUDED.expire_at\\n        WHERE \\\"mtw_provenance_dislock_v3_67dcf57e90_0\\\".\\\"key_value\\\".expire_at <= NOW()\\n        RETURNING key, expire_at;\\n        \",\"time\":407000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\"},{\"columns\":[{\"name\":\"key\",\"typeCode\":25},{\"name\":\"expire_at\",\"typeCode\":1184}],\"complete\":true,\"kind\":\"rows\",\"rows\":[[\"cronjob-lock:schedule:fixture-schedule-and-server-clock\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 11:41:28.596548+08:00\"}]],\"seq\":9,\"serverRows\":[[\"cronjob-lock:schedule:fixture-schedule-and-server-clock\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 11:41:28.596548+08:00\"},null,\"2bc2358c-321e-4160-8eed-e1e864140d5c\",null,null,{\"captureType\":\"datetime\",\"value\":\"2026-10-21 11:41:18.777132+08:00\"},\"bdc0544d-8743-4be6-992d-8bdb5b8ea8d3\",\"INSERT\"]],\"statement\":8,\"time\":438000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\"},{\"evidence\":{\"action\":\"INSERT\",\"serverRow\":0},\"key\":\"cronjob-lock:schedule:fixture-schedule-and-server-clock\",\"kind\":\"write\",\"mappingId\":\"dislock.acquire-schedule/1\",\"predecessor\":\"bdc0544d-8743-4be6-992d-8bdb5b8ea8d3\",\"seq\":10,\"statement\":8,\"time\":438000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\",\"version\":\"2bc2358c-321e-4160-8eed-e1e864140d5c\"},{\"kind\":\"commit_request\",\"seq\":11,\"time\":438000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\"},{\"kind\":\"commit_ok\",\"seq\":12,\"time\":438000000,\"tx\":\"transaction-708bfd02d96d44d3b933036423c04e26\"}],\"gaps\":[]}\n"
  assert_eq(
    v3_dislock_sha256(text),
    "236ab50e0b4864becd46e5314d693012ce83221ba41de59135aed554e5aaf07f",
  )
  let proof = v3_dislock_sql_proof(
    object_fields(@json.parse(text), "actual capture"),
  )
  assert_eq(proof.gaps.to_json(), Json::array([]))
  assert_eq(proof.verified_statements.length(), 2)
  assert_true(proof.verified_statements.contains(3L))
  assert_true(proof.verified_statements.contains(8L))
  assert_eq(proof.verified_facts.length(), 1)
  assert_true(proof.verified_facts.contains(10L))
  assert_eq(proof.verified_profiles.length(), 1)
  let normalized = @json.parse(normalize_register_capture_v3_json(text))
  assert_eq(capture_field(normalized, "status"), "inconclusive".to_json())
  assert_eq(capture_field(normalized, "history"), Json::null())
}

///|
fn d3_test_set(root : Json, path : Array[Json], value : Json) -> Unit raise {
  let mut current = root
  for i in 0..<(path.length() - 1) {
    current = match (current, path[i]) {
      (Object(fields), String(key)) => required(fields, key, "fixture")
      (Array(items), Number(n, ..)) => items[n.to_int()]
      _ => fail("Bad fixture path")
    }
  }
  match (current, path[path.length() - 1]) {
    (Object(fields), String(key)) => fields[key] = value
    (Array(items), Number(n, ..)) => items[n.to_int()] = value
    _ => fail("Bad fixture target")
  }
}

///|
test "dislock v3 diagnostic remains distinct from accepting analysis coverage" {
  let trace = d3_test_fixture()
  let diagnostic = @json.parse(dislock_sql_v3_proof_json(trace.stringify()))
  assert_eq(
    capture_field(diagnostic, "algorithm"),
    "dislock-f9946f0-sql-proof-1".to_json(),
  )
  assert_eq(
    capture_field(diagnostic, "analysisCoverageAccepted"),
    false.to_json(),
  )
  assert_eq(capture_field(diagnostic, "verifiedStatements"), [3].to_json())
  assert_eq(capture_field(diagnostic, "verifiedFacts"), [5, 6].to_json())
  let normalized = @json.parse(
    normalize_register_capture_v3_json(trace.stringify()),
  )
  assert_eq(capture_field(normalized, "status"), "inconclusive".to_json())
  assert_eq(capture_field(normalized, "history"), Json::null())
}

///|
test "dislock v3 diagnostic refuses an invalid transaction lifecycle" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["events", 6, "kind"], "commit_ok".to_json())
  let diagnostic = @json.parse(dislock_sql_v3_proof_json(trace.stringify()))
  assert_eq(
    capture_field(diagnostic, "analysisCoverageAccepted"),
    false.to_json(),
  )
  assert_eq(capture_field(diagnostic, "verifiedStatements"), Json::array([]))
  assert_eq(capture_field(diagnostic, "verifiedFacts"), Json::array([]))
  assert_true(!v3_test_items(diagnostic, "gaps").is_empty())
}

///|
test "dislock v3 a later delivered row cannot backfill an earlier mapped fact" {
  let trace = d3_test_fixture()
  let events = v3_test_items(trace, "events")
  let row = events[3]
  let write = events[4]
  object_fields_unchecked_v3(row)["seq"] = (5).to_json()
  object_fields_unchecked_v3(row)["time"] = (4).to_json()
  object_fields_unchecked_v3(write)["seq"] = (4).to_json()
  object_fields_unchecked_v3(write)["time"] = (3).to_json()
  events[3] = write
  events[4] = row
  let _ = d3_test_proof(trace, false)
}

///|
fn d3_test_proof(trace : Json, expected : Bool) -> V3DislockSQLProof raise {
  let proof = v3_dislock_sql_proof(object_fields(trace, "trace"))
  if expected {
    assert_eq(proof.gaps.to_json(), Json::array([]))
    assert_eq(proof.verified_statements.length(), 1)
    assert_true(proof.verified_statements.contains(3L))
    assert_eq(proof.verified_facts.length(), 2)
    assert_true(proof.verified_facts.contains(5L))
    assert_true(proof.verified_facts.contains(6L))
    assert_eq(proof.verified_profiles.length(), 1)
  } else {
    assert_true(proof.gaps.length() > 0)
    assert_eq(proof.verified_statements.length(), 0)
    assert_eq(proof.verified_facts.length(), 0)
    assert_eq(proof.verified_profiles.length(), 0)
  }
  proof
}

///|
test "dislock v3 exact SQL parameters rows sources catalog and committed ledger jointly prove renewal" {
  let _ = d3_test_proof(d3_test_fixture(), true)
}

///|
test "dislock v3 SHA256 binds standard vectors and multiblock source text" {
  assert_eq(
    v3_dislock_sha256(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  assert_eq(
    v3_dislock_sha256("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
  assert_eq(
    v3_dislock_sha256(
      "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    ),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
  )
}

///|
test "dislock v3 timestamp comparison keeps timezone and microseconds" {
  let first : Json = {
    "captureType": "datetime",
    "value": "2024-02-29 23:59:59.123456+08:00",
  }
  let same : Json = {
    "captureType": "datetime",
    "value": "2024-02-29 15:59:59.123456+00:00",
  }
  assert_eq(v3_dislock_time(first), v3_dislock_time(same))
  let next : Json = {
    "captureType": "datetime",
    "value": "2024-02-29 15:59:59.123457+00:00",
  }
  assert_eq(v3_dislock_time(next) - v3_dislock_time(same), 1L)
  for
    invalid in [
      "2023-02-29 00:00:00+00:00", "2024-01-01 00:00:00", "2024-01-01 00:00:60+00:00",
      "2024-01-01 00:00:00.1234567+00:00", "2024-01-01 00:00:00+24:00",
    ] {
    let rejected = try {
      let _ = v3_dislock_time({
        "captureType": "datetime",
        "value": invalid.to_json(),
      })
      false
    } catch {
      _ => true
    }
    assert_true(rejected)
  }
}

///|
test "dislock v3 finite interval multiplication rounds exact microseconds to nearest even" {
  assert_eq(v3_dislock_ttl(5.0.to_json()), 5000000L)
  assert_eq(v3_dislock_ttl(0.0000005.to_json()), 0L)
  assert_eq(v3_dislock_ttl(0.0000015.to_json()), 2L)
  assert_eq(v3_dislock_ttl((-0.0000005).to_json()), 0L)
  assert_eq(v3_dislock_ttl((-0.0000015).to_json()), -2L)
  let rejected = try {
    let _ = v3_dislock_ttl(31536001.0.to_json())
    false
  } catch {
    _ => true
  }
  assert_true(rejected)
}

///|
test "dislock v3 Python compatible ASCII DDL encoding retains supplementary Unicode" {
  assert_eq(
    v3_dislock_ascii_json("月🙂\"\\\n"),
    "\"\\u6708\\ud83d\\ude42\\\"\\\\\\n\"",
  )
}

