  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 29 condition NOW cannot be forged" {
  let trace = d3_test_fixture()
  d3_test_set(
    trace,
    ["events", 5, "evidence", "serverNow"],
    @json.parse(
      "{\"captureType\":\"datetime\",\"value\":\"2026-10-21 00:00:11+00:00\"}",
    ),
  )
  let _ = d3_test_proof(trace, false)
}

