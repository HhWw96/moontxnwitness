///|
test "dislock v3 zero row failed predicate cannot invent a negative point read" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["events", 3, "rows"], Json::array([]))
  d3_test_set(trace, ["events", 3, "serverRows"], Json::array([]))
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 a verified flag cannot restore missing actual catalog" {
  let trace = d3_test_fixture()
  d3_test_set(
    trace,
    ["sqlProfiles", 0, "metadata", "catalog"],
    Json::object(Map([])),
  )
  d3_test_set(trace, ["sqlProfiles", 0, "metadata", "verified"], true.to_json())
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 no relevant profile grants no exemptions" {
  let root : Map[String, Json] = Map([])
  let proof = v3_dislock_sql_proof(root)
  assert_eq(proof.verified_statements.length(), 0)
  assert_eq(proof.verified_facts.length(), 0)
  assert_eq(proof.verified_profiles.length(), 0)
  assert_eq(proof.gaps.length(), 0)
}
