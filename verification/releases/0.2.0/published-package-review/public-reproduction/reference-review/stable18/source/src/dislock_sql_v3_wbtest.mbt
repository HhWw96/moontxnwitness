eq\":19,\"sourceVersion\":\"7138f8c4-4155-45a3-b5c0-59aec78106c5\",\"statement\":16,\"time\":515000000,\"tx\":\"transaction-5f1c6666a080445082b47280e538b549\"},{\"kind\":\"commit_request\",\"seq\":20,\"time\":515000000,\"tx\":\"transaction-5f1c6666a080445082b47280e538b549\"},{\"kind\":\"commit_ok\",\"seq\":21,\"time\":515000000,\"tx\":\"transaction-5f1c6666a080445082b47280e538b549\"}],\"gaps\":[]}\n"
  assert_eq(
    v3_dislock_sha256(text),
    "53ac038833b07a0f348757aeb411034e127b44965b0bbe5472e8056e0c89b8b2",
  )
  let proof = v3_dislock_sql_proof(
    object_fields(@json.parse(text), "actual capture"),
  )
  assert_eq(proof.gaps.to_json(), Json::array([]))
  assert_eq(proof.verified_statements.length(), 3)
  assert_true(proof.verified_statements.contains(3L))
  assert_true(proof.verified_statements.contains(9L))
  assert_true(proof.verified_statements.contains(16L))
  assert_eq(proof.verified_facts.length(), 5)
  assert_true(proof.verified_facts.contains(5L))
  assert_true(proof.verified_facts.contains(11L))
  assert_true(proof.verified_facts.contains(12L))
  assert_true(proof.verified_facts.contains(18L))
  assert_true(proof.verified_facts.contains(19L))
  assert_eq(proof.verified_profiles.length(), 1)
  let normalized = @json.parse(normalize_register_capture_v3_json(text))
  assert_eq(capture_field(normalized, "status"), "inconclusive".to_json())
  assert_eq(capture_field(normalized, "history"), Json::null())
}

