///|
/// Fabricated catalog/row fixtures test semantic validation only. They are not
/// a claim of actual PostgreSQL execution or an authenticated database receipt.

///|
test "dislock v3 an inconsistent snapshot cannot prove complete SQL sources" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["events", 0, "consistent"], @json.parse("false"))
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 snapshot sequence must be original sequence one" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["events", 0, "seq"], @json.parse("2"))
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 missing event sequence cannot be ignored" {
  let trace = d3_test_fixture()
  let events = v3_test_items(trace, "events")
  let _ = object_fields_unchecked_v3(events[4]).remove("seq")
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 an interior sequence gap cannot be ignored" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["events", 4, "seq"], @json.parse("50"))
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 open writers cannot obtain a complete SQL profile" {
  let trace = d3_test_fixture()
  d3_test_set(trace, ["scope", "exclusiveWriters"], @json.parse("false"))
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 explicit capture gaps prevent a complete source profile" {
  let trace = d3_test_fixture()
  d3_test_set(
    trace,
    ["gaps"],
    @json.parse("[{\"code\":\"lost_event\",\"message\":\"captured loss\"}]"),
  )
  let _ = d3_test_proof(trace, false)
}

///|
test "dislock v3 snapshot cannot follow a transaction begin" {
  let trace = d3_test_fixture()
  let events = v3_test_items(trace, "events")
  let snapshot = events[0]
  let begin = events[1]
  events[0] = begin
  events[1] = snapshot
  for index, event in events {
    object_fields_unchecked_v3(event)["seq"] = (index + 1).to_json()
    object_fields_unchecked_v3(event)["time"] = index.to_json()
  }
  let _ = d3_test_proof(trace, false)
}

