test "dislock v3 actual recorded aborted-commit-response" {
  let text = "{\"traceSchema\":3,\"clockDomain\":\"mtw-v3-028727b9c99f4b56b90dc4a293fe82fc\",\"scope\":{\"exclusiveWriters\":true},\"sqlProfiles\":[],\"gaps\":[{\"code\":\"statement_failed\",\"message\":\"A business statement raised its original driver exception.\"},{\"code\":\"diagnostic_only\",\"message\":\"This export is incomplete diagnostic evidence, not a complete analysis input.\"}],\"events\":[{\"consistent\":true,\"initial\":{},\"kind\":\"snapshot\",\"seq\":1,\"time\":32000000},{\"connection\":\"connection-39dcee19e59543308210a02ad14363c2\",\"kind\":\"begin\",\"seq\":2,\"time\":391000000,\"tx\":\"transaction-f1870a10a6c64e9786f5e1eb064f38d5\"},{\"kind\":\"statement\",\"parameters\":null,\"seq\":3,\"sql\":\"SELECT 1/0\",\"time\":391000000,\"tx\":\"transaction-f1870a10a6c64e9786f5e1eb064f38d5\"},{\"complete\":false,\"error\":{\"class\":\"DivisionByZero\",\"sqlstate\":\"22012\"},\"kind\":\"rows\",\"rows\":[],\"seq\":4,\"statement\":3,\"time\":407000000,\"tx\":\"transaction-f1870a10a6c64e9786f5e1eb064f38d5\"},{\"kind\":\"commit_request\",\"seq\":5,\"time\":407000000,\"tx\":\"transaction-f1870a10a6c64e9786f5e1eb064f38d5\"},{\"commitResponse\":{\"commandTag\":\"ROLLBACK\",\"request\":5},\"kind\":\"rollback_ok\",\"seq\":6,\"time\":407000000,\"tx\":\"transaction-f1870a10a6c64e9786f5e1eb064f38d5\"}]}\n"
  assert_eq(
    v3_dislock_sha256(text),
    "972f10c803aa1239fa4d59c2aebf8741c8eef2ed2799b1ad04fef0f76bc4b831",
  )
  let proof = v3_dislock_sql_proof(
    object_fields(@json.parse(text), "actual capture"),
  )
  assert_eq(proof.verified_statements.length(), 0)
  assert_eq(proof.verified_facts.length(), 0)
  assert_eq(proof.verified_profiles.length(), 0)
  assert_eq(proof.gaps.length(), 0)
  let normalized = @json.parse(normalize_register_capture_v3_json(text))
  assert_eq(capture_field(normalized, "status"), "inconclusive".to_json())
  assert_eq(capture_field(normalized, "history"), Json::null())
}

