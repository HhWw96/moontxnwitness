  assert_eq(
    v3_dislock_sha256(text),
    "50b337a0482002b9c4fe8645c8c09ba36878e0562366ddb0ca3de2ef46d073f5",
  )
  let proof = v3_dislock_sql_proof(
    object_fields(@json.parse(text), "actual capture"),
  )
  assert_eq(proof.gaps.to_json(), Json::array([]))
  assert_eq(proof.verified_statements.length(), 2)
  assert_true(proof.verified_statements.contains(3L))
  assert_true(proof.verified_statements.contains(9L))
  assert_eq(proof.verified_facts.length(), 3)
  assert_true(proof.verified_facts.contains(5L))
  assert_true(proof.verified_facts.contains(11L))
  assert_true(proof.verified_facts.contains(12L))
  assert_eq(proof.verified_profiles.length(), 1)
  let normalized = @json.parse(normalize_register_capture_v3_json(text))
  assert_eq(capture_field(normalized, "status"), "inconclusive".to_json())
  assert_eq(capture_field(normalized, "history"), Json::null())
}

