test "dislock v3 conflict UPDATE verifies real expiry guard and new owner" {
  let trace = @json.parse(
    "{\"traceSchema\":3,\"clockDomain\":\"unit\",\"scope\":{\"exclusiveWriters\":true},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"x\":\"00000000-0000-0000-0000-000000000001\"},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"c\",\"seq\":2,\"time\":1},{\"kind\":\"statement\",\"tx\":\"A\",\"mappingId\":\"dislock.acquire-run/1\",\"sql\":\"\\n        INSERT INTO \\\"mtw_provenance_unit\\\".\\\"key_value\\\" (key, value, expire_at)\\n        VALUES (%s, %s, NOW() + (%s * INTERVAL '1 second'))\\n        ON CONFLICT (key) DO UPDATE\\n        SET value = EXCLUDED.value,\\n            expire_at = EXCLUDED.expire_at\\n        WHERE \\\"mtw_provenance_unit\\\".\\\"key_value\\\".expire_at <= NOW()\\n        RETURNING key, expire_at;\\n        \",\"executedSql\":\"\\n        INSERT INTO \\\"mtw_provenance_unit\\\".\\\"key_value\\\" (key, value, expire_at)\\n        VALUES (%s, %s, NOW() + (%s * INTERVAL '1 second'))\\n        ON CONFLICT (key) DO UPDATE\\n        SET value = EXCLUDED.value,\\n            expire_at = EXCLUDED.expire_at\\n        WHERE \\\"mtw_provenance_unit\\\".\\\"key_value\\\".expire_at <= NOW()\\n        RETURNING key, expire_at,OLD.\\\"_mtw_v3_version\\\"::text,NEW.\\\"_mtw_v3_version\\\"::text,OLD.value,OLD.expire_at,NOW(),\\\"mtw_provenance_unit\\\".\\\"_mtw_v3_predecessor\\\"(NEW.\\\"_mtw_v3_version\\\"::text),CASE WHEN OLD.key IS NULL THEN 'INSERT' ELSE 'UPDATE' END;\\n        \",\"parameters\":[\"x\",\"new-owner\",5],\"seq\":3,\"time\":2},{\"kind\":\"rows\",\"tx\":\"A\",\"statement\":3,\"rows\":[[\"x\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 00:00:15+00:00\"}]],\"serverRows\":[[\"x\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 00:00:15+00:00\"},\"00000000-0000-0000-0000-000000000001\",\"00000000-0000-0000-0000-000000000002\",\"owner\",{\"captureType\":\"datetime\",\"value\":\"2026-10-21 00:00:00+00:00\"},{\"captureType\":\"datetime\",\"value\":\"2026-10-21 00:00:10+00:00\"},\"000000