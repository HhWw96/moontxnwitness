{
  "schemaVersion": 1,
  "name": "Actual concurrent SQLite WAL capture with aborted snapshots and retries",
  "model": "strict-serializable",
  "initial": {
    "x": "x0",
    "y": "y0"
  },
  "versionOrders": {
    "x": [
      "x0",
      "x:r0:B",
      "x:r1:B"
    ],
    "y": [
      "y0",
      "y:r0:A:retry",
      "y:r1:A:retry"
    ]
  },
  "transactions": [
    {
      "id": "r0-A",
      "status": "aborted",
      "start": 0,
      "end": 0,
      "ops": [
        {
          "type": "read",
          "key": "x",
          "version": "x0"
        }
      ]
    },
    {
      "id": "r0-B",
      "status": "committed",
      "start": 0,
      "end": 16000,
      "ops": [
        {
          "type": "read",
          "key": "y",
          "version": "y0"
        },
        {
          "type": "write",
          "key": "x",
          "version": "x:r0:B"
        }
      ]
    },
    {
      "id": "r0-A-retry",
      "status": "committed",
      "start": 16000,
      "end": 32000,
      "ops": [
        {
          "type": "read",
          "key": "x",
          "version": "x:r0:B"
        },
        {
          "type": "write",
          "key": "y",
          "version": "y:r0:A:retry"
        }
      ]
    },
    {
      "id": "r1-A",
      "status": "aborted",
      "start": 32000,
      "end": 47000,
      "ops": [
        {
          "type": "read",
          "key": "x",
          "version": "x:r0:B"
        }
      ]
    },
    {
      "id": "r1-B",
      "status": "committed",
      "start": 32000,
      "end": 63000,
      "ops": [
        {
          "type": "read",
          "key": "y",
          "version": "y:r0:A:retry"
        },
        {
          "type": "write",
          "key": "x",
          "version": "x:r1:B"
        }
      ]
    },
    {
      "id": "r1-A-retry",
      "status": "committed",
      "start": 63000,
      "end": 78000,
      "ops": [
        {
          "type": "read",
          "key": "x",
          "version": "x:r1:B"
        },
        {
          "type": "write",
          "key": "y",
          "version": "y:r1:A:retry"
        }
      ]
    }
  ]
}
