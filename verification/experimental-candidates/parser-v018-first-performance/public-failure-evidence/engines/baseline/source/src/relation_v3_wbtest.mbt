///|
test "relation SDK normalizer options dispatch and reject unrelated SQL proof" {
  let text = "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}],\"complete\":true,\"seq\":3,\"time\":2},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":4,\"time\":3},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":5,\"time\":4}],\"gaps\":[]}"
  let expected = @json.parse(normalize_relation_capture_v3_json(text))
  assert_eq(@json.parse(normalize_capture_v3_json(text)), expected)
  assert_eq(
    @json.parse(normalize_capture_v3_options_json(text, "{}")),
    expected,
  )
  let rejected = @json.parse(
    normalize_capture_v3_options_json(
      text, "{\"sqlProof\":\"dislock-f9946f0-sql-proof-1\"}",
    ),
  )
  assert_eq(capture_field(rejected, "status"), "invalid".to_json())
  assert_eq(capture_field(rejected, "history"), Json::null())
}

///|
test "relation SDK analyze and verify bind complete model and source facts" {
  let text = "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}],\"complete\":true,\"seq\":3,\"time\":2},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":4,\"time\":3},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":5,\"time\":4}],\"gaps\":[]}"
  let report = analyze_v3_json(text, "{}")
  assert_eq(
    capture_field(@json.parse(report), "status"),
    "consistent".to_json(),
  )
  assert_eq(
    capture_field(@json.parse(verify_v3_json(text, report)), "valid"),
    true.to_json(),
  )
  let tampered = object_fields(@json.parse(report), "report")
  tampered["modelDefinition"] = { "id": "register-serializable-v1" }
  assert_eq(
    capture_field(
      @json.parse(verify_v3_json(text, Json::object(tampered).stringify())),
      "valid",
    ),
    false.to_json(),
  )
}

///|
test "relation generic reduction removes noise and revalidates source closure" {
  let text = "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[],\"complete\":true,\"seq\":3,\"time\":2},{\"kind\":\"begin\",\"tx\":\"B\",\"connection\":\"B\",\"seq\":4,\"time\":3},{\"kind\":\"row_read\",\"tx\":\"B\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[],\"complete\":true,\"seq\":5,\"time\":4},{\"kind\":\"row_write\",\"tx\":\"A\",\"relation\":\"accounts\",\"key\":\"1\",\"action\":\"insert\",\"version\":\"a\",\"predecessor\":null,\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"},\"seq\":6,\"time\":5},{\"kind\":\"row_write\",\"tx\":\"B\",\"relation\":\"accounts\",\"key\":\"2\",\"action\":\"insert\",\"version\":\"b\",\"predecessor\":null,\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"},\"seq\":7,\"time\":6},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":8,\"time\":7},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":9,\"time\":8},{\"kind\":\"commit_request\",\"tx\":\"B\",\"seq\":10,\"time\":9},{\"kind\":\"commit_ok\",\"tx\":\"B\",\"seq\":11,\"time\":10},{\"kind\":\"begin\",\"tx\":\"Noise\",\"connection\":\"noise\",\"seq\":12,\"time\":11},{\"kind\":\"commit_request\",\"tx\":\"Noise\",\"seq\":13,\"time\":12},{\"kind\":\"commit_ok\",\"tx\":\"Noise\",\"seq\":14,\"time\":13}],\"gaps\":[]}"
  let reduced = @json.parse(
    reduce_v3_json(
      text, "{\"analysisOptions\":{\"maxStates\":100000},\"maxChecks\":256}",
    ),
  )
  assert_eq(capture_field(reduced, "status"), "reduced".to_json())
  assert_eq(capture_field(reduced, "oneMinimal"), true.to_json())
  assert_eq(capture_field(reduced, "removed"), ["Noise"].to_json())
  assert_eq(
    capture_field(capture_field(reduced, "report"), "status"),
    "violation".to_json(),
  )
  assert_eq(
    capture_field(reduced, "predicate"),
    "definite relation-set serializability violation with complete capture coverage".to_json(),
  )
}

