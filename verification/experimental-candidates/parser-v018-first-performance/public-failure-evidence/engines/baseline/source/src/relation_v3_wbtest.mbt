///|
fn r3_test_case(
  text : String,
  status : String,
  expected : String,
  options : String,
) -> Unit raise {
  let report = relation_v3_analysis(text, options)
  assert_eq(capture_field(report, "status"), status.to_json())
  assert_eq(capture_field(report, "algorithm"), "v3-relation-1".to_json())
  let normalized = capture_field(report, "normalized")
  assert_eq(capture_field(normalized, "history"), Json::null())
  assert_eq(
    capture_field(normalized, "observations"),
    capture_field(@json.parse(text), "events"),
  )
  assert_eq(@json.parse(normalize_relation_capture_v3_json(text)), normalized)
  l3_test_subset(report, @json.parse(expected))
}

///|
test "relation v3 001 empty snapshot no transactions" {
  r3_test_case(
    "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[]},\"consistent\":true,\"seq\":1,\"time\":0}],\"gaps\":[]}",
    "consistent", "{\"evidence\":{\"serialOrder\":[]},\"execution\":{\"metrics\":{\"states\":0,\"operationChecks\":0}}}",
    "{}",
  )
}

