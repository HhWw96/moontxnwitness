}

///|
test "relation independent-fix 07 written NUL version preserves scalar predecessor and writer" {
  r3_test_case(
    "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_write\",\"tx\":\"A\",\"relation\":\"accounts\",\"key\":\"1\",\"action\":\"update\",\"version\":\"\\u0000\",\"predecessor\":\"v0\",\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"},\"seq\":3,\"time\":2},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[{\"key\":\"1\",\"version\":\"\\u0000\",\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"}}],\"complete\":true,\"seq\":4,\"time\":3},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":5,\"time\":4},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":6,\"time\":5}],\"gaps\":[]}",
    "consistent", "{\"normalized\":{\"effects\":[{\"predecessor\":\"v0\",\"version\":\"\\u0000\"}]},\"evidence\":{\"sourceEvidence\":[{\"version\":\"v0\",\"writer\":null,\"predecessor\":null},{\"version\":\"\\u0000\",\"writer\":\"A\",\"predecessor\":\"v0\"}]}}",
    "{}",
  )
}

///|
test "relation independent-fix 08 fresh absence predecessor is JSON null rather than optional array" {
  r3_test_case(
    "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_write\",\"tx\":\"A\",\"relation\":\"accounts\",\"key\":\"1\",\"action\":\"insert\",\"version\":\"v1\",\"predecessor\":null,\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"},\"seq\":3,\"time\":2},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[{\"key\":\"1\",\"version\":\"v1\",\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"}}],\"complete\":true,\"seq\":4,\"time\":3},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":5,\"time\":4},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":6,\"time\":5}],\"gaps\":[]}",
    "consistent", "{\"normalized\":{\"effects\":[{\"predecessor\":null}]},\"evidence\":{\"sourceEvidence\":[{\"writer\":\"A\",\"predecessor\":null}]}}",
    "{}",
  )
}

