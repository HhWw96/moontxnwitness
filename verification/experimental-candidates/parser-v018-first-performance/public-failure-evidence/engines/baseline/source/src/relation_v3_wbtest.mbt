  r3_test_case(
    "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"accounts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"int64\",\"balance\":\"int64\",\"active\":\"bool\",\"region\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"accounts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"accounts\":[{\"key\":\"1\",\"version\":\"v0\",\"values\":{\"balance\":\"10\",\"active\":true,\"region\":\"north\"}}]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_write\",\"tx\":\"A\",\"relation\":\"accounts\",\"key\":\"1\",\"action\":\"delete\",\"version\":\"\\u0000\",\"predecessor\":\"v0\",\"values\":null,\"seq\":3,\"time\":2},{\"kind\":\"row_write\",\"tx\":\"A\",\"relation\":\"accounts\",\"key\":\"1\",\"action\":\"insert\",\"version\":\"\\n\",\"predecessor\":\"\\u0000\",\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"},\"seq\":4,\"time\":3},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"accounts\",\"predicate\":[],\"rows\":[{\"key\":\"1\",\"version\":\"\\n\",\"values\":{\"balance\":\"20\",\"active\":true,\"region\":\"north\"}}],\"complete\":true,\"seq\":5,\"time\":4},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":6,\"time\":5},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":7,\"time\":6}],\"gaps\":[]}",
    "consistent", "{\"normalized\":{\"effects\":[{\"version\":\"\\u0000\",\"predecessor\":\"v0\"},{\"version\":\"\\n\",\"predecessor\":\"\\u0000\"}],\"transactions\":[{\"finalWrites\":[4]}]},\"evidence\":{\"sourceEvidence\":[{\"writer\":null,\"predecessor\":null},{\"writer\":\"A\",\"predecessor\":\"v0\"},{\"writer\":\"A\",\"predecessor\":\"\\u0000\"}]}}",
    "{}",
  )
}
