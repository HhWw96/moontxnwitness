    "{\"traceSchema\":3,\"dataModel\":\"relation-set-v1\",\"relationSchema\":{\"texts\":{\"primaryKey\":\"id\",\"columns\":{\"id\":\"text\",\"value\":\"text\"}}},\"clockDomain\":\"relation-own-tests\",\"scope\":{\"exclusiveWriters\":true,\"completeSnapshotTables\":[\"texts\"]},\"events\":[{\"kind\":\"snapshot\",\"initial\":{\"texts\":[{\"key\":\"\",\"version\":\"empty\",\"values\":{\"value\":\"\"}},{\"key\":\"a|text|b\",\"version\":\"separator\",\"values\":{\"value\":\"x\"}}]},\"consistent\":true,\"seq\":1,\"time\":0},{\"kind\":\"begin\",\"tx\":\"A\",\"connection\":\"A\",\"seq\":2,\"time\":1},{\"kind\":\"row_read\",\"tx\":\"A\",\"relation\":\"texts\",\"predicate\":[],\"rows\":[{\"key\":\"\",\"version\":\"empty\",\"values\":{\"value\":\"\"}},{\"key\":\"a|text|b\",\"version\":\"separator\",\"values\":{\"value\":\"x\"}}],\"complete\":true,\"seq\":3,\"time\":2},{\"kind\":\"commit_request\",\"tx\":\"A\",\"seq\":4,\"time\":3},{\"kind\":\"commit_ok\",\"tx\":\"A\",\"seq\":5,\"time\":4}],\"gaps\":[]}",
    "consistent", "{}", "{}",
  )
}

