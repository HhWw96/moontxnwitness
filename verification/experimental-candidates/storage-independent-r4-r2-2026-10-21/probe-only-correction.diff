+def probe(path, nonce, held_stream, record_path, expected_binding=None):
+    record = {'exitCode': None, 'stdout': None, 'rawStdout': '', 'stderr': '',
+              'authorityBefore': None, 'authorityAfter': None}
+    try:
+        record['authorityBefore'] = held_authority(path, nonce, held_stream)
+        child = subprocess.run([sys.executable, '-B', str(Path(__file__).resolve()), '--probe-coordination', str(path),
+                                '--expected-nonce', nonce], capture_output=True, text=True, encoding='utf-8', errors='replace',
+                               timeout=15, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+        record.update(exitCode=child.returncode, rawStdout=child.stdout, stderr=child.stderr)
+        record['authorityAfter'] = held_authority(path, nonce, held_stream)
+        ensure(len(child.stdout.encode()) <= 65536 and len(child.stderr.encode()) <= 65536, 'Native probe output bound')
+        record['stdout'] = json.loads(child.stdout.strip())
+    except BaseException as error:
