+def held_authority(path, expected_nonce, stream):
+    """Read the actual owning handle, never a second handle denied by Windows."""
+    info = path.lstat()
+    opened = os.fstat(stream.fileno())
+    ensure(stat.S_ISREG(info.st_mode) and not path.is_symlink(), 'Regular permanent mutex required')
+    ensure((info.st_dev, info.st_ino) == (opened.st_dev, opened.st_ino), 'Held mutex path/inode changed')
+    position = stream.tell()
+    try:
+        stream.seek(0)
+        raw = stream.read(4097)
+    finally:
+        stream.seek(position)
+    expected = json.dumps({'kind': 'archive-coordination/1', 'nonce': expected_nonce},
+                          sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()
+    ensure(raw == expected, 'Held mutex full bytes/nonce differ')
+    return {'nonce': expected_nonce, 'device': info.st_dev, 'inode': info.st_ino,
+            'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}
+
+
+def capture_real_lock(managed, path, observed):
+    """Retain the real file object after the unmodified native call returns."""
+    real = managed.os_lock
+
+    def lock(stream):
+        real(stream)
+        if Path(stream.name).resolve() == path:
+            observed['stream'] = stream
+    return lock
