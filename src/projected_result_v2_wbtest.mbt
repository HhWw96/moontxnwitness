}

///|
fn projected52_run(fixture : Json, options~ : Json = {}) -> Json raise {
  let f = object_fields(fixture, "projected fixture")
  sql_json_v1(
    verify_projected_result_v2_json(
      f.at("config").stringify(),
      sql_string_v1(f.at("source")),
      f.at("typed").stringify(),
      f.at("options").stringify(),
      f.at("descriptor").stringify(),
      f.at("native").stringify(),
      f.at("deliveries").stringify(),
      options.stringify(),
    ),
    8388608,
  )
}

///|
fn projected52_no_facts(report : Json) -> Unit raise {
  for
    name in [
      "sourceFactsProduced", "captureFactsProduced", "sourceAuthenticated", "catalogVerified",
      "sourceColumnMappingVerified", "completeWindow", "sourceWindowVerified", "modelCoverageAccepted",
      "commitVerified", "committedWriteEffectVerified", "moonbitProjectionVerified",
      "absenceSourceVerified",
    ] {
    assert_eq(v4_test_at(report, [name]), Json(false))
  }
}

///|
fn projected52_native(fixture : Json) -> Map[String, Json] raise {
  object_fields(v4_test_at(fixture, ["native", "native"]), "native")
}

///|
fn projected52_cell(fixture : Json, index : Int32) -> Array[Json] raise {
  let rows = orm_array(projected52_native(fixture).at("rows"))
  let cells = orm_array(rows[0])
  ignore(index)
  cells
}

///|
fn projected52_status(fixture : Json, expected : String) -> Unit raise {
  let report = projected52_run(fixture)
  assert_eq(v4_test_at(report, ["status"]), Json(expected))
  projected52_no_facts(report)
}

///|
test "projected52 twelve real producer frame pairs preserve three scalar key layouts" {
  for index = 0; index < 12; index = index + 1 {
    let fixture = projected52_recorded(index)
    let report = projected52_run(fixture)
    assert_eq(
      v4_test_at(report, ["status"]),
      Json("matched"),
      msg=report.stringify(),
    )
    assert_eq(v4_test_at(report, ["rowImageConsistencyVerified"]), Json(true))
    assert_eq(
      v4_test_at(report, ["nativeFrameObservation"]),
      v4_test_at(fixture, ["native"]),
    )
    assert_eq(
      v4_test_at(report, ["deliveryObservations"]),
      v4_test_at(fixture, ["deliveries"]),
    )
    projected52_no_facts(report)
  }
}

///|
test "projected52 independent caller budgets cannot be granted by descriptors" {
  let fixture = projected52_recorded(0)
  let budgets : Array[Json] = [
    { "maxChecks": 0 },
    { "maxCellBytes": 0 },
    { "maxTotalBytes": 0 },
    { "maxDeliveryRecords": 0 },
    { "projectionBudget": { "maxChecks": 0 } },
    { "projectionBudget": { "grammarOptions": { "maxChecks": 0 } } },
  ]
  for options in budgets {
    let report = projected52_run(fixture, options~)
    assert_eq(v4_test_at(report, ["status"]), Json("unknown"))
    projected52_no_facts(report)
  }
}

///|
test "projected52 no business fetch remains partial even with a full native buffer" {
  let fixture = projected52_recorded(0)
  object_fields(fixture, "fixture")["deliveries"] = []
  projected52_status(fixture, "partial")
  let command = projected52_recorded(2)
  projected52_status(command, "matched")
}

///|
test "projected52 descriptor and independent inputs are recomputed before buffer trust" {
  let fixture = projected52_recorded(0)
  object_fields(v4_test_at(fixture, ["descriptor"]), "descriptor")["projectedSql"] = "SELECT forged"
  projected52_status(fixture, "mismatch")
  let fixture = projected52_recorded(0)
  object_fields(v4_test_at(fixture, ["options"]), "options")["versionColumn"] = "other_version"
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 source flags and missing observation references never grant admission" {
  for key in ["resultId", "connection", "cursor", "tx", "statementSeq"] {
    let fixture = projected52_recorded(0)
    let first = object_fields(
      orm_array(v4_test_at(fixture, ["deliveries"]))[0],
      "delivery",
    )
    first[key] = if key == "statementSeq" {
      Json(123456)
    } else {
      Json("wrong")
    }
    projected52_status(fixture, "mismatch")
  }
  let fixture = projected52_recorded(0)
  object_fields(v4_test_at(fixture, ["native"]), "frame")["projectionNoteSeq"] = Json::null()
  projected52_status(fixture, "unknown")
  let fixture = projected52_recorded(0)
  object_fields(v4_test_at(fixture, ["native"]), "frame")["sourceFactsProduced"] = Json(
    true,
  )
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 field names order oid format count and tags are checked" {
  for key in ["nameBase64", "format", "oid"] {
    let fixture = projected52_recorded(0)
    let field = object_fields(
      orm_array(projected52_native(fixture).at("fields"))[0],
      "field",
    )
    field[key] = if key == "nameBase64" {
      result52_b64("wrong")
    } else if key == "format" {
      Json(1)
    } else {
      Json(16)
    }
    projected52_status(
      fixture,
      if key == "nameBase64" {
        "mismatch"
      } else {
        "unknown"
      },
    )
  }
  let fixture = projected52_recorded(0)
  projected52_native(fixture)["commandStatusBase64"] = result52_b64("UPDATE 1")
  projected52_status(fixture, "mismatch")
  let fixture = projected52_recorded(0)
  object_fields(projected52_native(fixture).at("commandTuples"), "getter")["value"] = "0"
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 original key is enforced beyond matching raw and business values" {
  let fixture = projected52_recorded(0)
  projected52_cell(fixture, 0)[0] = result52_b64("999")
  let first = object_fields(
    orm_array(v4_test_at(fixture, ["deliveries"]))[0],
    "delivery",
  )
  let cells = orm_array(
    object_fields(orm_array(first.at("rows"))[0], "row").at("cells"),
  )
  object_fields(cells[0], "cell")["value"] = "999"
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 update assigned unchanged and version fields are checked" {
  let fixture = projected52_recorded(2)
  // no-RETURNING update layout: OLD key,balance,enabled,label,version; NEW same.
  projected52_cell(fixture, 6)[6] = result52_b64("999")
  projected52_status(fixture, "mismatch")
  let fixture = projected52_recorded(2)
  projected52_cell(fixture, 7)[7] = result52_b64("f")
  projected52_status(fixture, "mismatch")
  let fixture = projected52_recorded(2)
  let cells = projected52_cell(fixture, 9)
  cells[9] = cells[4]
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 hidden versions require positive bigint native values" {
  for value in ["0", "-1"] {
    let fixture = projected52_recorded(0)
    projected52_cell(fixture, 4)[4] = result52_b64(value)
    projected52_status(fixture, "mismatch")
  }
  let fixture = projected52_recorded(0)
  object_fields(
    orm_array(projected52_native(fixture).at("fields"))[4],
    "version field",
  )["oid"] = Json(23)
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 inserted full row must match all original input values" {
  let fixture = projected52_recorded(1)
  let fields = orm_array(v4_test_at(fixture, ["descriptor", "hiddenResults"]))
  let hidden = object_fields(fields[0], "new")
  let columns = orm_array(hidden.at("columns"))
  let index = fetch_number_v1(
    object_fields(columns[1], "balance").at("nativeIndex"),
    52,
  )
  projected52_cell(fixture, index)[index] = result52_b64("999")
  projected52_status(fixture, "mismatch")
}

///|
test "projected52 delivery cannot include hidden images or change native scalar types" {
  for mode in ["extra", "type", "position"] {
    let fixture = projected52_recorded(0)
    let batch = object_fields(
      orm_array(v4_test_at(fixture, ["deliveries"]))[0],
      "batch",
    )
    let row = object_fields(orm_array(batch.at("rows"))[0], "row")
    let cells = orm_array(row.at("cells"))
    if mode == "extra" {
      cells.push({ "pythonType": "builtins.int", "value": "1" })
    } else if mode == "type" {
      object_fields(cells[0], "cell")["pythonType"] = "builtins.str"
    } else {
      batch["start"] = Json(1)
    }
    projected52_status(
      fixture,
      if mode == "type" {
        "unknown"
      } else {
        "mismatch"
      },
    )
  }
}

///|
test "projected52 command only hidden results cannot become business delivery" {
  let fixture = projected52_recorded(2)
  object_fields(fixture, "fixture")["deliveries"] = v4_test_at(
    projected52_recorded(0),
    ["deliveries"],
  )
  projected52_status(fixture, "mismatch")
}

///|
fn projected52_empty_select() -> Json raise {
  // Deliberately synthetic boundary derived from a recorded shape. This does
  // not claim PostgreSQL executed a different SQL/row count than the receipt.
  let fixture = projected52_recorded(0)
  let native = projected52_native(fixture)
  native["rows"] = []
  native["commandStatusBase64"] = result52_b64("SELECT 0")
  object_fields(native.at("commandTuples"), "getter")["value"] = "0"
  let batch = object_fields(
    orm_array(v4_test_at(fixture, ["deliveries"]))[0],
    "batch",
  )
  batch["rows"] = []
  batch["start"] = Json(0)
  batch["method"] = "fetchmany"
  batch["requestedSize"] = Json(0)
  batch["effectiveSize"] = Json(1)
  batch["resultPythonType"] = "builtins.list"
  batch["exhaustedObserved"] = Json(false)
  fixture
}

///|
test "projected52 zero rows need actual meaningful fetch and preserve UUID metadata checks" {
  let fixture = projected52_empty_select()
  projected52_status(fixture, "matched")
  let batch = object_fields(
    orm_array(v4_test_at(fixture, ["deliveries"]))[0],
    "batch",
  )
  batch["effectiveSize"] = Json(0)
  batch["exhaustedObserved"] = Json(true)
  projected52_status(fixture, "partial")
  let fixture = projected52_empty_select()
  object_fields(fixture, "fixture")["deliveries"] = []
  projected52_status(fixture, "partial")
  let fixture = projected52_empty_select()
  object_fields(orm_array(projected52_native(fixture).at("fields"))[0], "field")["oid"] = Json(
    16,
  )
  projected52_status(fixture, "unknown")
}

///|
test "projected52 missing native encoding command or delivery observation is unknown" {
  let fixture = projected52_recorded(0)
  object_fields(fixture, "fixture")["native"] = Json::null()
  projected52_status(fixture, "unknown")
  let fixture = projected52_recorded(0)
  object_fields(fixture, "fixture")["deliveries"] = Json::null()
  projected52_status(fixture, "unknown")
  for name in ["clientEncodingBase64", "commandStatusBase64", "commandTuples"] {
    let fixture = projected52_recorded(0)
    projected52_native(fixture)[name] = Json::null()
    projected52_status(fixture, "unknown")
  }
}

///|
test "projected52 unknown option fields and oversized budgets are not accepted" {
  for
    options_text in [
      "{\"maxChecks\":1000001}", "{\"unknown\":true}", "{\"maxCellBytes\":-1}", "{\"projectionBudget\":{\"extra\":1}}",
    ] {
    let report = projected52_run(
      projected52_recorded(0),
      options=sql_json_v1(options_text, 1024),
    )
    assert_eq(
      v4_test_at(report, ["status"]),
      Json("invalid"),
      msg=options_text + report.stringify(),
    )
    projected52_no_facts(report)
  }
}

///|
fn projected52_rebuild(fixture : Json) -> Unit raise {
  let fields = object_fields(fixture, "synthetic changed inputs")
  let config = parse_sql_config_v2(fields.at("config").stringify()).unwrap()
  let options = point_projection_options_wire_v2(
    config,
    fields.at("options").stringify(),
  )
  let work : PointProjectionWorkV2 = {
    budget: point_projection_verification_options_v2(),
    checks: 0,
    atoms: [],
    named: Map([]),
    container: "",
    mapping: [],
  }
  fields["descriptor"] = point_projection_build_v2(
    work,
    config,
    sql_string_v1(fields.at("source")),
    fields.at("typed"),
    options,
  )
}

///|
test "projected52 literal point keys follow the independent grammar boundary" {
  // Synthetic equivalent SQL input variants; the original receipt does not
  // claim these literals were executed. Native payloads remain observations.
  for (index, literal) in [(0, "7")] {
    let fixture = projected52_recorded(index)
    let fields = object_fields(fixture, "fixture")
    fields["source"] = Json(
      sql_string_v1(fields.at("source")).replace_all(old="%s", new=literal),
    )
    fields["typed"] = { "container": "none", "items": [] }
    projected52_rebuild(fixture)
    projected52_status(fixture, "matched")
  }
  let fixture = projected52_recorded(2)
  let fields = object_fields(fixture, "fixture")
  fields["source"] = "UPDATE \"bank\".\"accounts\" SET \"balance\"=%s WHERE \"number\"=9"
  fields["typed"] = {
    "container": "tuple",
    "items": [{ "pythonType": "int", "decimal": "23" }],
  }
  projected52_rebuild(fixture)
  projected52_status(fixture, "matched")
  let fixture = projected52_recorded(8)
  let fields = object_fields(fixture, "fixture")
  fields["source"] = Json(
    sql_string_v1(fields.at("source")).replace_all(
      old="%s",
      new="'a8098c1a-f86e-11da-bd1a-00112444be1e'",
    ),
  )
  fields["typed"] = { "container": "none", "items": [] }
  projected52_status(fixture, "unknown")
  let fixture = projected52_recorded(2)
  let fields = object_fields(fixture, "fixture")
  fields["source"] = "UPDATE \"bank\".\"accounts\" SET \"balance\"=23 WHERE \"number\"=9"
  fields["typed"] = { "container": "none", "items": [] }
  projected52_status(fixture, "unknown")
}
