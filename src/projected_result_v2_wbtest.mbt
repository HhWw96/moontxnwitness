ries\":[{\"connection\":\"connection-0077cb8f978e47eb9c3f99c71228bbb8\",\"cursor\":\"cursor-8ff0d682be304e4aae435e380dfe16db\",\"effectiveSize\":null,\"exhaustedObserved\":false,\"format\":\"moontxnwitness-projected-delivery/v2\",\"method\":\"fetchone\",\"requestedSize\":null,\"resultId\":\"point-result-5b1e3cad2b9d4076a3b59991dd2b3e5e\",\"resultPythonType\":\"builtins.tuple\",\"rows\":[{\"cells\":[{\"pythonType\":\"uuid.UUID\",\"value\":\"00000000-0000-0000-0000-000000000009\"},{\"pythonType\":\"builtins.str\",\"value\":\"原始🙂\"},{\"pythonType\":\"builtins.bool\",\"value\":true}],\"pythonType\":\"builtins.tuple\"}],\"sourceFactsProduced\":false,\"start\":0,\"statementSeq\":45,\"tx\":\"transaction-cec13d078be44c70ac4efe61fcb189ef\"},{\"connection\":\"connection-0077cb8f978e47eb9c3f99c71228bbb8\",\"cursor\":\"cursor-8ff0d682be304e4aae435e380dfe16db\",\"effectiveSize\":null,\"exhaustedObserved\":true,\"format\":\"moontxnwitness-projected-delivery/v2\",\"method\":\"fetchone\",\"requestedSize\":null,\"resultId\":\"point-result-5b1e3cad2b9d4076a3b59991dd2b3e5e\",\"resultPythonType\":\"builtins.NoneType\",\"rows\":[],\"sourceFactsProduced\":false,\"start\":1,\"statementSeq\":45,\"tx\":\"transaction-cec13d078be44c70ac4efe61fcb189ef\"}]}",
  ]
