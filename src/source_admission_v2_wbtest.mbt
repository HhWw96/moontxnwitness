///|
fn source_a52_run(fixture : Json, limit~ : Int32 = 1000000) -> Json raise {
  let f = source_object_v4(fixture)
  let config = match parse_sql_config_v2(f.at("config").stringify()) {
    Ok(value) => value
    Err(e) => fail(e)
  }
  source_admission_v2_json(
    verify_source_admission_v2(
      config,
      f.at("policy"),
      sql_string_v1(f.at("log")),
      f.at("receipt"),
      max_checks=limit,
    ),
  )
}

///|
fn source_a52_no_authority(report : Json) -> Unit raise {
  let r = source_object_v4(report)
  for
    flag in [
      "sourceAuthenticated", "sourceFactsProduced", "captureFactsProduced", "completeWindow",
      "writerWindowVerified", "modelCoverageAccepted", "commitVerified",
    ] {
    assert_eq(r.at(flag), Json(false))
  }
}

///|
fn source_a52_records(fixture : Json) -> Array[Json] raise {
  let rows : Array[Json] = []
  for line in sql_string_v1(source_object_v4(fixture).at("log")).split("\n") {
    if !line.is_empty() {
      rows.push(sql_json_v1(line.to_owned(), 524288))
    }
  }
  rows
}

///|
fn source_a52_reseal(fixture : Json, records : Array[Json]) -> Unit raise {
  let prefix = StringBuilder()
  for index in 0..<(records.length() - 1) {
    prefix.write_string(sql_canonical_v1(records[index]))
    prefix.write_string("\n")
  }
  let seal : Json = {
    "seq": Json(records.length()),
    "kind": "seal",
    "records": Json(records.length() - 1),
    "prefixSha256": Json(v3_dislock_sha256(prefix.to_string())),
  }
  prefix.write_string(sql_canonical_v1(seal))
  prefix.write_string("\n")
  let text = prefix.to_string()
  let f = source_object_v4(fixture)
  f["log"] = Json(text)
  let r = source_object_v4(f.at("receipt"))
  r["log"] = {
    "format": "moontxnwitness-source-installation-log/v2",
    "sealed": true,
    "records": Json(records.length()),
    "bytes": Json(orm_utf8_size(text)),
    "sha256": Json(v3_dislock_sha256(text)),
  }
}

///|
fn source_a52_change_control(
  fixture : Json,
  query : String,
  change : (Json) -> Unit raise,
) -> Unit raise {
  let records = source_a52_records(fixture)
  let mut changed : Json = Json::null()
  for raw in records {
    let r = source_object_v4(raw)
    if r.get("queryId") == Some(Json(query)) &&
      r.at("kind") == Json("control-native") {
      let native = source_object_v4(r.at("native"))
      let rows = orm_array(native.at("rows"))
      let text = admission_bytes_v2(orm_array(rows[0])[0], 131072)
      changed = sql_json_v1(text, 131072)
      change(changed)
      rows[0] = Json([
        Json(@base64.encode(@utf8.encode(sql_canonical_v1(changed))[:])),
      ])
    }
    if r.get("queryId") == Some(Json(query)) &&
      r.at("kind") == Json("control-delivery") &&
      changed != Json::null() {
      let observation = source_object_v4(r.at("observation"))
      let row = source_object_v4(orm_array(observation.at("rows"))[0])
      source_object_v4(orm_array(row.at("cells"))[0])["value"] = Json(
        sql_canonical_v1(changed),
      )
      break
    }
  }
  source_a52_reseal(fixture, records)
}

///|
test "admission52 verifies three original PG18 installation logs without granting window authority" {
  for index in 0..<3 {
    let result = source_a52_run(source_a52_fixture(index))
    assert_eq(
      source_object_v4(result).at("status"),
      Json("verified"),
      msg=sql_canonical_v1(result),
    )
    assert_eq(source_object_v4(result).at("installationVerified"), Json(true))
    assert_eq(source_object_v4(result).at("initialRows"), Json(1))
    source_a52_no_authority(result)
  }
}

///|
test "admission52 caller zero and exact-prefix budgets never grant installation" {
  for limit in [0, 1, 8, 100] {
    let report = source_a52_run(source_a52_fixture(0), limit~)
    assert_eq(source_object_v4(report).at("status"), Json("unknown"))
    assert_eq(source_object_v4(report).at("installationVerified"), Json(false))
    source_a52_no_authority(report)
  }
}

///|
test "admission52 receipt summary cannot replace native initialized rows" {
  for name in ["initialRows", "initialSnapshotSha256", "actualCommitConfirmed"] {
    let fixture = source_a52_fixture(0)
    let r = source_object_v4(source_object_v4(fixture).at("receipt"))
    r[name] = if name == "initialRows" {
      Json(99)
    } else if name == "actualCommitConfirmed" {
      Json(false)
    } else {
      Json("wrong")
    }
    let result = source_a52_run(fixture)
    assert_eq(source_object_v4(result).at("installationVerified"), Json(false))
    source_a52_no_authority(result)
  }
}

///|
test "admission52 rehashed unsafe source owner is refused beyond receipt equality" {
  let fixture = source_a52_fixture(0)
  source_a52_change_control(fixture, "environment", value => {
    source_object_v4(source_object_v4(value).at("ownerRole"))["superuser"] = Json(
      true,
    )
    source_object_v4(source_object_v4(fixture).at("receipt"))["environment"] = value
  })
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("unknown"))
  source_a52_no_authority(report)
}

///|
test "admission52 UUID cannot masquerade as text with rehashed matching receipt" {
  let fixture = source_a52_fixture(2)
  source_a52_change_control(fixture, "installed-catalog", value => {
    for raw in orm_array(source_object_v4(value).at("columns")) {
      let c = source_object_v4(raw)
      if c.at("name") == Json("identity") {
        c["oid"] = Json(25)
      }
    }
    source_object_v4(source_object_v4(fixture).at("receipt"))["afterCatalog"] = value
  })
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("installationVerified"), Json(false))
  source_a52_no_authority(report)
}

///|
test "admission52 role guard and immutable key trigger body cannot be weakened" {
  let fixture = source_a52_fixture(0)
  source_a52_change_control(fixture, "installed-catalog", value => {
    let t = source_object_v4(
      orm_array(source_object_v4(value).at("triggers"))[0],
    )
    t["body"] = Json("BEGIN RETURN NEW; END;")
    source_object_v4(source_object_v4(fixture).at("receipt"))["afterCatalog"] = value
  })
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("mismatch"))
  source_a52_no_authority(report)
}

///|
test "admission52 full initial ledger content is checked not merely row count" {
  let fixture = source_a52_fixture(0)
  source_a52_change_control(fixture, "verify-initial-ledger", value => {
    source_object_v4(source_object_v4(value).at("rowValues"))["balance"] = Json(
      999,
    )
  })
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("mismatch"))
  source_a52_no_authority(report)
}

///|
test "admission52 native delivery mismatch survives recomputed outer log digests" {
  let fixture = source_a52_fixture(0)
  let records = source_a52_records(fixture)
  for raw in records {
    let r = source_object_v4(raw)
    if r.get("queryId") == Some(Json("environment")) &&
      r.at("kind") == Json("control-delivery") {
      let o = source_object_v4(r.at("observation"))
      let row = source_object_v4(orm_array(o.at("rows"))[0])
      source_object_v4(orm_array(row.at("cells"))[0])["value"] = Json("{}")
    }
  }
  source_a52_reseal(fixture, records)
  let result = source_a52_run(fixture)
  assert_eq(source_object_v4(result).at("status"), Json("mismatch"))
  source_a52_no_authority(result)
}

///|
test "admission52 rehashed rollback response is not a confirmed commit" {
  let fixture = source_a52_fixture(0)
  let records = source_a52_records(fixture)
  for raw in records {
    let r = source_object_v4(raw)
    if r.get("queryId") == Some(Json("installation-commit")) &&
      r.at("kind") == Json("control-native") {
      source_object_v4(r.at("native"))["commandStatusBase64"] = Json(
        @base64.encode(@utf8.encode("ROLLBACK")[:]),
      )
    }
  }
  source_a52_reseal(fixture, records)
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("mismatch"))
  source_a52_no_authority(report)
}

///|
test "admission52 command getter must agree with the native command tag" {
  let fixture = source_a52_fixture(0)
  let records = source_a52_records(fixture)
  for raw in records {
    let r = source_object_v4(raw)
    if r.get("queryId") == Some(Json("install-scope")) &&
      r.at("kind") == Json("control-native") {
      source_object_v4(r.at("native"))["commandTuples"] = {
        "pythonType": "builtins.int",
        "value": "0",
      }
    }
  }
  source_a52_reseal(fixture, records)
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("mismatch"))
  source_a52_no_authority(report)
}

///|
test "admission52 caller policy cannot be replaced by the embedded receipt" {
  let fixture = source_a52_fixture(0)
  source_object_v4(source_object_v4(fixture).at("policy"))["writers"] = Json([
    Json("different_writer"),
  ])
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("mismatch"))
  source_a52_no_authority(report)
}

///|
test "admission52 older installation without observed safe path stays unknown" {
  let fixture = source_a52_fixture(0)
  let original = source_a52_records(fixture)
  let records : Array[Json] = []
  let seqs : Map[String, Json] = Map([])
  for raw in original {
    let record = source_object_v4(raw)
    if record.get("queryId") == Some(Json("safe-search-path")) ||
      record.at("kind") == Json("seal") {
      continue
    }
    let old_seq = sql_number_text_v1(record.at("seq"))
    let new_seq = Json(records.length() + 1)
    seqs[old_seq] = new_seq
    record["seq"] = new_seq
    match record.get("requestSeq") {
      Some(value) => record["requestSeq"] = seqs.at(sql_number_text_v1(value))
      None => ()
    }
    records.push(raw)
  }
  records.push(original[original.length() - 1])
  source_a52_reseal(fixture, records)
  let report = source_a52_run(fixture)
  assert_eq(source_object_v4(report).at("status"), Json("unknown"))
  assert_eq(source_object_v4(report).at("installationVerified"), Json(false))
  source_a52_no_authority(report)
}

///|
test "admission52 wire validates independent option shape without trusting budget labels" {
  let fixture = source_object_v4(source_a52_fixture(0))
  for
    options in [
      "{\"maxChecks\":-1}", "{\"budget:fake\":1}", "{\"maxChecks\":1000001}",
    ] {
    let report = sql_json_v1(
      verify_source_admission_v2_json(
        fixture.at("config").stringify(),
        fixture.at("policy").stringify(),
        sql_string_v1(fixture.at("log")),
        fixture.at("receipt").stringify(),
        options,
      ),
      1048576,
    )
    assert_eq(source_object_v4(report).at("status"), Json("invalid"))
    source_a52_no_authority(report)
  }
}
