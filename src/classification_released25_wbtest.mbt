ull},{\"seq\":5,\"tx\":\"B\",\"key\":\"y\",\"version\":\"y1\",\"predecessor\":\"y0\",\"revertedBy\":null},{\"seq\":6,\"tx\":\"A\",\"key\":\"y\",\"version\":\"y2\",\"predecessor\":\"y1\",\"revertedBy\":null},{\"seq\":7,\"tx\":\"B\",\"key\":\"x\",\"version\":\"x2\",\"predecessor\":\"x1\",\"revertedBy\":null}],\"transactions\":[{\"id\":\"A\",\"connection\":\"a\",\"status\":\"committed\",\"beginSeq\":2,\"endSeq\":9,\"events\":[2,4,6,8,9],\"finalWrites\":[4,6]},{\"id\":\"B\",\"connection\":\"b\",\"status\":\"committed\",\"beginSeq\":3,\"endSeq\":11,\"events\":[3,5,7,10,11],\"finalWrites\":[5,7]}],\"history\":{\"schemaVersion\":1,\"model\":\"serializable\",\"initial\":{\"x\":\"0.2.0\",\"y\":\"y0\"},\"versionOrders\":{\"x\":[\"0.2.0\",\"x1\",\"x2\"],\"y\":[\"y0\",\"y1\",\"y2\"]},\"transactions\":[{\"id\":\"A\",\"status\":\"committed\",\"ops\":[{\"type\":\"write\",\"key\":\"x\",\"version\":\"x1\"},{\"type\":\"write\",\"key\":\"y\",\"version\":\"y2\"}],\"start\":null,\"end\":null},{\"id\":\"B\",\"status\":\"committed\",\"ops\":[{\"type\":\"write\",\"key\":\"y\",\"version\":\"y1\"},{\"type\":\"write\",\"key\":\"x\",\"version\":\"x2\"}],\"start\":null,\"end\":null}]}},\"dependencies\":[{\"from\":\"A\",\"to\":\"B\",\"kind\":\"ww\",\"key\":\"x\",\"fromOp\":0,\"toOp\":1,\"fromVersion\":\"x1\",\"toVersion\":\"x2\",\"reason\":\"The asserted per-key version order puts this write before the next write.\"},{\"from\":\"B\",\"to\":\"A\",\"kind\":\"ww\",\"key\":\"y\",\"fromOp\":0,\"toOp\":1,\"fromVersion\":\"y1\",\"toVersion\":\"y2\",\"reason\":\"The asserted per-key version order puts this write before the next write.\"}],\"dependencyGraphComplete\":true,\"rules\":{\"G0\":{\"status\":\"refuted\",\"reason\":\"complete\",\"states\":1,\"edgeChecks\":2,\"evidence\":{\"kind\":\"category-dependency-cycle\",\"specificCategory\":\"G0\",\"edges\":[{\"edge\":{\"from\":\"A\",\"to\":\"B\",\"kind\":\"ww\",\"key\":\"x\",\"fromOp\":0,\"toOp\":1,\"fromVersion\":\"x1\",\"toVersion\":\"x2\",\"reason\":\"The asserted per-key version order puts this write before the next write.\"},\"fromObservationSeq\":[4],\"toObservationSeq\":[7],\"capturedVersionOrder\":[\"0.2.0\",\"x1\",\"x2\"]},{\"edge\":{\"from\":\"B\",\"to\":\"A\",\"kind\":\"ww\",\"key\":\"y\",\"fromOp\":0,\"toOp\":1,\"fromVersion\":\"y1\",\"toVersion\":\"y2\",\"reason\":\"The asserted per-key version order puts this write before the next write.\"},\"fromObservationSeq\":[5],\"toObservationSeq\":[6],\"capturedVersionOrder\":[\"y0\",\"y1\",\"y2\"]}],\"minimality\":\"a simple cycle for this category; no global or category-shortest claim\",\"sourceScope\":\"all matching original observations plus the captured predecessor version chain; input assertions are not database authentication\"}}},\"impliedAnomalies\":[\"G0\",\"G1c\",\"G1\"],\"execution\":{\"classificationOptions\":{\"categories\":[\"G0\"],\"maxStates\":100000,\"maxEdgeChecks\":1000000},\"limits\":{\"transactions\":128,\"operations\":4096,\"edges\":50000,\"statesPerCategory\":100000,\"edgeChecksPerCategory\":1000000},\"versionOrderCompletion\":false}}"
