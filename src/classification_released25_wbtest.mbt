///|
// These literal reports were produced by the anonymous public 0.2.5 core.
// The separate fixture manifest binds their original producer bytes.
fn released25_category_verification(
  text : String,
  report : String,
) -> Bool raise {
  object_fields_unchecked_v3(
    @json.parse(verify_classification_v3_json(text, report)),
  ).get("valid") ==
  Some(Json(true))
}

