   \"version\": \"a1\",\n        \"predecessor\": null,\n        \"values\": {\n          \"n\": \"2\",\n          \"b\": true,\n          \"t\": \"0.2.0\"\n        }\n      },\n      {\n        \"seq\": 11,\n        \"time\": 11,\n        \"kind\": \"commit_request\",\n        \"tx\": \"A\"\n      },\n      {\n        \"seq\": 12,\n        \"time\": 12,\n        \"kind\": \"commit_ok\",\n        \"tx\": \"A\"\n      },\n      {\n        \"seq\": 13,\n        \"time\": 13,\n        \"kind\": \"row_write\",\n        \"tx\": \"B\",\n        \"relation\": \"r\",\n        \"key\": \"2\",\n        \"action\": \"insert\",\n        \"version\": \"b1\",\n        \"predecessor\": null,\n        \"values\": {\n          \"n\": \"3\",\n          \"b\": true,\n          \"t\": \"0.2.0\"\n        }\n      },\n      {\n        \"seq\": 14,\n        \"time\": 14,\n        \"kind\": \"commit_request\",\n        \"tx\": \"B\"\n      },\n      {\n        \"seq\": 15,\n        \"time\": 15,\n        \"kind\": \"commit_ok\",\n        \"tx\": \"B\"\n      },\n      {\n        \"seq\": 16,\n        \"time\": 16,\n        \"kind\": \"begin\",\n        \"tx\": \"N\",\n        \"connection\": \"connection-N\"\n      },\n      {\n        \"seq\": 17,\n        \"time\": 17,\n        \"kind\": \"row_write\",\n        \"tx\": \"N\",\n        \"relation\": \"noise\",\n        \"key\": \"9\",\n        \"action\": \"insert\",\n        \"version\": \"n1\",\n        \"predecessor\": null,\n        \"values\": {\n          \"n\": \"9\",\n          \"b\": true,\n          \"t\": \"0.2.0\"\n        }\n      },\n      {\n        \"seq\": 18,\n        \"time\": 18,\n        \"kind\": \"commit_request\",\n        \"tx\": \"N\"\n      },\n      {\n        \"seq\": 19,\n        \"time\": 19,\n        \"kind\": \"commit_ok\",\n        \"tx\": \"N\"\n      }\n    ],\n    \"effects\": [\n      {\n        \"seq\": 3,\n        \"tx\": \"P\",\n        \"relation\": \"r\",\n        \"key\": \"0\",\n        \"actio