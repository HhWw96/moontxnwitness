* text=auto eol=lf
*.zip binary
*.wasm binary
# Content-addressed raw captures must keep their recorded bytes on every OS.
verification/business/dislock/** -text
verification/provenance-presence/** -text
fixtures/v3/** -text
verification/v3/** -text
verification/package.json -text
fixtures/list-v3/** -text
verification/list-v3/** -text
verification/faults/mlflow/** -text
fixtures/relation-v3/** -text
verification/relation-v3/** -text
# Immutable patch receipts include significant context-line whitespace.
*.patch -text -whitespace
verification/performance-v3-drafts/** -text
verification/classification-v3/** -text
verification/experimental-candidates/** -text
verification/public-audit-tools/** -text
verification/public-audit-tools/**/*.diff -text -whitespace
verification/public-audit-results/** -text
# Compiler diagnostic alignment is part of immutable raw log bytes.
verification/experimental-candidates/**/*.log -text -whitespace
# Fixed upstream source/license and frozen input bytes retain original whitespace.
verification/experimental-candidates/elle-smoke*/primary-references/** -text -whitespace
verification/experimental-candidates/elle-smoke*/smoke-inputs-v1.json -text -whitespace
experiments/faults/mlflow/upstream/fetch-receipt.json -text
experiments/relation_v3/candidate-index.json -text
